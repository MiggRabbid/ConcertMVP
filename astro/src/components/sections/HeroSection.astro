---
import type { Messages } from "../../app/i18n/messages";
import type { HeroSlide } from "../../app/types/home";
import Icon from "../ui/Icon.astro";

interface Props {
  slides: HeroSlide[];
  brandImage: string;
  messages: Messages;
}

const { slides, brandImage, messages } = Astro.props;
---

<section class="hero" id="top" role="region" aria-label={messages.hero.carousel} aria-roledescription="carousel" data-hero>
  <div class="hero__backdrop"></div>
  <div class="hero__brand" aria-hidden="true">
    <img class="hero__brand-image" src={brandImage} alt="" />
    <span class="hero__brand-copy">
      <b class="hero__brand-title">Сириус</b>
      <small class="hero__brand-subtitle">концертный<br />центр</small>
    </span>
  </div>
  <div class="hero__viewport">
    <div class="hero__track" data-hero-track>
      {slides.map((slide, index) => (
        <article
          class="hero-slide"
          aria-hidden={index !== 0 ? "true" : "false"}
          aria-roledescription="slide"
          data-hero-slide
        >
          <div class="hero-slide__image-wrap">
            <img
              class="hero-slide__image"
              src={slide.image}
              alt={slide.title}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
            />
          </div>
          <div class="hero-slide__copy">
            {index === 0
              ? <h1 class="hero-slide__title">{slide.title}</h1>
              : <h2 class="hero-slide__title">{slide.title}</h2>}
            <p class="hero-slide__description">{slide.description}</p>
            <a class="text-link" href="#" data-stub-link>
              {messages.hero.more} <Icon name="arrow-up-right" class="text-link__icon" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
  <div class="hero__controls">
    <button class="hero__control-button" type="button" aria-label={messages.hero.previous} data-hero-previous>
      <Icon name="chevron-left" class="hero__control-icon" />
    </button>
    <div class="hero__dots">
      {slides.map((_, index) => (
        <button
          class:list={["hero__dot", { "hero__dot-active": index === 0 }]}
          type="button"
          aria-label={`${index + 1}`}
          aria-current={index === 0 ? "true" : undefined}
          data-hero-dot={index}
        />
      ))}
    </div>
    <button class="hero__control-button" type="button" aria-label={messages.hero.next} data-hero-next>
      <Icon name="chevron-right" class="hero__control-icon" />
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-hero-track]");
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-hero-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-hero-dot]"));
    const previous = root.querySelector<HTMLButtonElement>("[data-hero-previous]");
    const next = root.querySelector<HTMLButtonElement>("[data-hero-next]");
    if (!track || slides.length === 0 || !previous || !next) return;

    let activeSlide = 0;
    let intervalId: number | undefined;

    const render = () => {
      track.style.transform = `translateX(-${activeSlide * 100}%)`;
      slides.forEach((slide, index) => slide.setAttribute("aria-hidden", String(index !== activeSlide)));
      dots.forEach((dot, index) => {
        const active = index === activeSlide;
        dot.classList.toggle("hero__dot-active", active);
        if (active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    const startAutoplay = () => {
      if (slides.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      window.clearInterval(intervalId);
      intervalId = window.setInterval(() => {
        activeSlide = (activeSlide + 1) % slides.length;
        render();
      }, 7_500);
    };

    const navigate = (direction: number) => {
      activeSlide = (activeSlide + direction + slides.length) % slides.length;
      render();
      startAutoplay();
    };

    previous.addEventListener("click", () => navigate(-1));
    next.addEventListener("click", () => navigate(1));
    dots.forEach((dot, index) => dot.addEventListener("click", () => {
      activeSlide = index;
      render();
      startAutoplay();
    }));
    startAutoplay();
  });
</script>
