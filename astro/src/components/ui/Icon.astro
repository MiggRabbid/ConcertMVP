---
type IconName = "arrow-left" | "arrow-up-right" | "calendar" | "chevron-left" |
  "chevron-right" | "clock" | "mail" | "map-pin" | "menu" | "phone" |
  "telegram" | "vk" | "x";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const isBrand = name === "telegram" || name === "vk";
const fill = isBrand ? "currentColor" : "none";
const strokeColor = isBrand ? "none" : "currentColor";
---

<svg
  class={className}
  viewBox="0 0 24 24"
  {fill}
  stroke={strokeColor}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "map-pin" && <><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></>}
  {name === "menu" && <><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></>}
  {name === "x" && <><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></>}
  {name === "arrow-up-right" && <><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></>}
  {name === "chevron-left" && <polyline points="15 18 9 12 15 6"></polyline>}
  {name === "chevron-right" && <polyline points="9 18 15 12 9 6"></polyline>}
  {name === "mail" && <><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path><polyline points="22 6 12 13 2 6"></polyline></>}
  {name === "phone" && <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92z"></path>}
  {name === "arrow-left" && <><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></>}
  {name === "calendar" && <><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></>}
  {name === "clock" && <><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15 14"></polyline></>}
  {name === "telegram" && <path d="M2 11.3 21.6 3l-3.8 17.7-6.1-4.5-3 2.9v-5.2L18 6.2 6.6 12.5z"></path>}
  {name === "vk" && <path d="M2 6.5h4.2c.3 4 2.1 7.5 3.8 7.8V6.5h4v4.4c1.7-.2 3.6-2.7 4.2-4.4H22c-.5 2.3-2.5 5-4.2 6.1 1.7.9 4.1 3.3 5 5.9h-4.2c-.8-1.7-2.8-3.8-4.6-4v4h-.5C6.8 18.5 3 14 2 6.5z"></path>}
</svg>
