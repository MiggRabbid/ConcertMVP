---
import { createFontFaceCss } from "../app/styles/fontFace";
import type { LanguageLinks } from "../app/types/layout";
import "../app/styles/main.css";

interface Props {
  title: string;
  description: string;
  assetBase: string;
  lang: "ru" | "en";
  languageLinks: LanguageLinks;
  siteName?: string;
  image?: string;
  type?: "website" | "event";
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  assetBase,
  lang,
  languageLinks,
  siteName = "Концертный центр «Сириус»",
  image,
  type = "website",
  jsonLd,
} = Astro.props;
const canonicalPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = Astro.site ? new URL(canonicalPath, Astro.site) : new URL(canonicalPath, Astro.url);
const socialImage = image ? new URL(image, canonical.origin) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={new URL(languageLinks.ru, canonical.origin)} />
    <link rel="alternate" hreflang="en" href={new URL(languageLinks.en, canonical.origin)} />
    <link rel="alternate" hreflang="x-default" href={new URL(languageLinks.ru, canonical.origin)} />
    <link rel="icon" href={`${assetBase}concert-assets/008-dc7f22d8.svg`} />
    <style is:inline set:html={createFontFaceCss(assetBase)} />
    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
